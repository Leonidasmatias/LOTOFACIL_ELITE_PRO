root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
indent_size = 2
# Duas ou mais espacos no fim da linha em Markdown forcam quebra de linha;
# nao remover automaticamente para nao alterar a renderizacao dos textos.
trim_trailing_whitespace = false

[*.csv]
# Dados historicos da Lotofacil / exportacoes: nao mexer em espacos ou
# newline final para nao arriscar alterar o conteudo dos dados.
insert_final_newline = false
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
